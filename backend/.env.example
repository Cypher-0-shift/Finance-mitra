# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Financial Mitra — Environment Variables Reference                          ║
# ║  Copy this file to .env and fill in real values.                            ║
# ║  NEVER commit .env to git. Check: `git status` should not show .env.        ║
# ║  Every variable used anywhere in the codebase is listed here.               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development         # 'development' | 'production'
LOG_LEVEL=INFO                  # 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR'

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Get from: Meta Developer → Your App → WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN=          # Token you set when registering the webhook callback URL
WHATSAPP_APP_SECRET=            # App Secret from Meta App Dashboard → Settings → Basic
WHATSAPP_ACCESS_TOKEN=          # Permanent or temporary user access token
WHATSAPP_PHONE_NUMBER_ID=       # Phone number ID from WhatsApp → API Setup
WHATSAPP_API_VERSION=v22.0      # Meta Graph API version — update when Meta deprecates

# ── Google Gemini (LLM — all call types) ─────────────────────────────────────
# Get from: Google AI Studio → API Keys (or Google Cloud Console if billing enabled)
GEMINI_API_KEY=

# ⚠️  CRITICAL — DATA PRIVACY GATE:
# Gemini FREE tier: Google may use prompts/responses to improve models.
# Gemini PAID tier (billing enabled on GCP project): this is excluded by default.
# This is a direct conflict with DPDP Act 2023 purpose-limitation if real users'
# financial conversations flow through the free tier.
# RULE: ENVIRONMENT=production MUST use GEMINI_TIER=paid. The app will REFUSE
# to start if ENVIRONMENT=production and GEMINI_TIER=free.
GEMINI_TIER=free                # 'free' | 'paid' — set to 'paid' before ANY real-user traffic

GEMINI_CORE_MODEL_CHEAP=gemini-2.5-flash        # Core Engine: money_decision + general intents
GEMINI_CORE_MODEL_STRONG=gemini-2.5-pro         # Core Engine: trust_check intent ONLY
# Note: gemini-2.5-flash-lite is scheduled to shut down on Oct 16, 2026. Verify model release before pilot end.
GEMINI_SHAPER_MODEL=gemini-2.5-flash-lite       # Language & Trust Shaper (cheapest/fastest)
GEMINI_VISION_MODEL=gemini-2.5-flash            # Vision LLM call for image inputs (Phase 5)
GEMINI_EMBEDDINGS_MODEL=models/text-embedding-004  # Must match the model used to populate scam_kb_cards

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # Service role key — scoped access only, never expose to client
SUPABASE_ANON_KEY=              # Anon key — for Supabase Auth operations only

# ── Security ──────────────────────────────────────────────────────────────────
# WHATSAPP_ID_HASH_SALT: server-side secret used when hashing WhatsApp phone numbers.
# The salt lives HERE, never in the database — without it the hash is only nominally irreversible.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WHATSAPP_ID_HASH_SALT=

# INTERNAL_SERVICE_TOKEN: bearer token for service-to-service calls
# (e.g. escalation notifier → internal API). Distinct from any user credential.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_TOKEN=

# RENDER_HEALTH_CHECK_TOKEN: shared secret on the /health endpoint so the
# keep-alive GitHub Actions ping isn't spoofable as a legitimate health signal.
RENDER_HEALTH_CHECK_TOKEN=

# ── Rate limiting & cost caps ─────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_WINDOW=20       # Max messages per user per window
RATE_LIMIT_WINDOW_SECONDS=3600          # Window duration in seconds (default: 1 hour)
PER_USER_DAILY_COST_CAP_INR=5           # Max estimated LLM spend per user per day (₹)

# ── Media handling ────────────────────────────────────────────────────────────
MEDIA_RETENTION_HOURS=24        # Hours before image files are deleted from transient storage
                                 # Pilot launch checklist item — auto-deletion, not manual
